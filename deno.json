{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "permissions": {
    "default": {
      "read": {
        "allow": ["./audio", "./video"]
      },
      "write": {
        "allow": ["./audio", "./video"]
      },
      "net": true,
      "run": {
        "allow": ["ytp-dlp"]
      }
    }
  },
  "tasks": {
    "dev": "deno serve --watch -R main.ts"
  },
  "imports": {
    "@std/http": "jsr:@std/http@1",
    "arktype": "npm:arktype"
  },
  "fmt": {
    "include": ["./"],
    "useTabs": true,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "include": ["./"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
